/* ---- Stream Analyze ---- */
/* SA logo: two overlapping squares, the overlap cut out. */
set sensehat:emoji_tbl("sa_logo") = [
  "WWWWW...",
  "WWWWW...",
  "WWWWW...",
  "WWW..WWW",
  "WWW..WWW",
  "...WWWWW",
  "...WWWWW",
  "...WWWWW"];

/* All emoji names, grouped as above (e.g. for a demo that shows them all). */
create function sensehat:emoji_names() -> Vector of Charstring
  as ["smile", "neutral", "sad", "wink", "surprised", "sunglasses",
      "heart", "check", "cross", "warning", "hourglass", "signal",
      "plug", "question", "sun", "cloud", "rain", "snow",
      "thermometer", "droplet", "arrow_up", "arrow_down", "arrow_left", "arrow_right",
      "compass", "rotate", "invader", "stream", "snake", "lightning",
      "sa_logo"];
