/*-*-sql-*-
 * sensehat-emoji.osql — 8x8 colour emojis for the Sense HAT LED matrix
 * (31 emojis). Loaded by sensehat-display.osql.
 *
 * Each emoji is 8 rows of 8 palette letters, top row first. Edit them by eye:
 *   .  off      W  white    Y  yellow   O  orange   R  red     G  green
 *   B  blue     C  cyan     M  purple   P  pink     S  grey
 * Show one with sensehat:show_emoji("smile"); sensehat:emoji_names() lists them all.
 */

/* Palette: letter -> [r, g, b]. Unknown letters show as off. */
create function sensehat:emoji_colour(Charstring letter) -> Vector of Integer as stored;

set sensehat:emoji_colour(".") = [0,0,0];   /* off */
set sensehat:emoji_colour("W") = [255,255,255];   /* white */
set sensehat:emoji_colour("Y") = [255,200,0];   /* yellow */
set sensehat:emoji_colour("O") = [255,100,0];   /* orange */
set sensehat:emoji_colour("R") = [255,0,0];   /* red */
set sensehat:emoji_colour("G") = [0,200,0];   /* green */
set sensehat:emoji_colour("B") = [0,60,255];   /* blue */
set sensehat:emoji_colour("C") = [0,200,200];   /* cyan */
set sensehat:emoji_colour("M") = [160,0,255];   /* purple */
set sensehat:emoji_colour("P") = [255,0,120];   /* pink */
set sensehat:emoji_colour("S") = [90,90,90];   /* grey */

/* Emoji name -> 8 rows of palette letters. */
create function sensehat:emoji_tbl(Charstring name) -> Vector of Charstring as stored;

/* ---- Faces ---- */
