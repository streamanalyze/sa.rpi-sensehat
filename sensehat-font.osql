set sensehat:glyph_tbl("x") = [136,72,112,144,136];
set sensehat:glyph_tbl("y") = [136,144,96,32,24];
set sensehat:glyph_tbl("z") = [136,200,168,152,136];
set sensehat:glyph_tbl("?") = [4,2,162,18,12];
set sensehat:glyph_tbl(",") = [160,96];
set sensehat:glyph_tbl(";") = [172,108];
set sensehat:glyph_tbl(":") = [108,108];
set sensehat:glyph_tbl("|") = [254];
set sensehat:glyph_tbl("@") = [100,146,242,130,124];
set sensehat:glyph_tbl("%") = [70,38,16,200,196];
set sensehat:glyph_tbl("[") = [254,130,130];
set sensehat:glyph_tbl("&") = [108,146,170,68,160];
set sensehat:glyph_tbl("_") = [128,128,128,128,128];
set sensehat:glyph_tbl("'") = [10,6];
set sensehat:glyph_tbl("]") = [130,130,254];
set sensehat:glyph_tbl("\\") = [4,8,16,32,64];
set sensehat:glyph_tbl("~") = [16,8,24,16,8];

/* All font characters in the font's own order (as in sense_hat_text.txt).
 * Built from pieces because the set contains both quote characters. */
create function sensehat:font_chars() -> Charstring
  as " +-*/!" || '"' || "#$><0123456789.=)(ABCDEFGHIJKLMNOPQRSTUVWXYZ"
     || "abcdefghijklmnopqrstuvwxyz?,;:|@%[&_" || "'" || "]\\~";
