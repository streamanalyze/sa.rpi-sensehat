/*-*-sql-*-
 * test-sa.rpi-sensehat.osql — validation test for the sensehat datapump extension
 *
 * Tests multi-flow datapump, stop/restart, and ODR cycling.
 *
 * Assumptions:
 *   - The Sense HAT is connected and /dev/i2c-1 is accessible.
 *   - The board is roughly stationary (accel magnitude ≈ 1 g).
 *
 * Run with:
 *   make test
 */

load_osql('sa.rpi-sensehat.osql');

/* ================================================================
 * Helper: count accel samples per 200 ms window
 * ================================================================ */

create function count_accel_samples(integer cnt) -> vector of real as
select vector of dim(value(tw))/win_length
from Timeval of vector tw, real win_length
where tw in twinagg(sensehat:flow("accel"), win_length, win_length)
  and win_length = .2
limit cnt;

/* ================================================================
 * Error handling — invalid ODR
 * ================================================================ */

validate "ODR 0 raises error"
   check register_sensehat_pump(0, 2048, 1000, 0)
         => ["*error*","sensehat: ODR must be 1-6",0];

validate "ODR 7 raises error"
   check register_sensehat_pump(7, 2048, 1000, 0)
         => ["*error*","sensehat: ODR must be 1-6",7];

/* ================================================================
 * ODR 6 (952 Hz) — accel + env, no gyro
 * ================================================================ */

register_sensehat_pump(6, 2048, 1000, 0);

/* ---- accel flow ---- */

validate "accel flow yields 10 readings"
   check count(extract(first_n(sensehat:flow("accel"), 10))) => 10;

validate "accel item carries topic name"
   check sensehat:topic(first(first_n(sensehat:flow("accel"), 1))) => "accel";

validate "accel payload is a 3-vector"
   check dim(sensehat:xyz(first(first_n(sensehat:flow("accel"), 1)))) => 3;

validate "accel timestamp is valid"
   check timestamp(first(first_n(sensehat:flow("accel"), 1)))
         > |2020-01-01T00:00:00Z| => true;

validate "accel magnitude near 1g when stationary"
   check roundto(avg(select am
                       from Timeval v, real am
                      where v in extract(first_n(sensehat:flow("accel"), 10))
and am = sensehat:accel_mag(v) and optional(print(am))),
                 1)
         => 1.0;

/* ---- pressure flow ---- */

validate "pressure flow yields a reading"
   check count(extract(first_n(sensehat:flow("pressure"), 1))) => 1;

validate "pressure in plausible range (hPa)"
   check select sensehat:scalar(v) > 900 and sensehat:scalar(v) < 1100
           from Timeval v
          where v in extract(first_n(sensehat:flow("pressure"), 1)) => true;

/* ---- temp flow ---- */

validate "temp flow yields a reading"
   check count(extract(first_n(sensehat:flow("temp"), 1))) => 1;

validate "temp in plausible range (C)"
   check select sensehat:scalar(v) > 0 and sensehat:scalar(v) < 80
           from Timeval v
          where v in extract(first_n(sensehat:flow("temp"), 1)) => true;

/* ---- signal_flows (merged) ---- */

validate "signal_flows merges accel and temp"
   check count(extract(first_n(sensehat:signal_flows(["accel","temp"]), 10)))
         => 10;

/* ---- rate at ODR 6 ---- */

set :a = count_accel_samples(4);
print("accel rate at ODR-6 (952 Hz): " + :a);
validate "accel rate at ODR 6"
check avg(:a) > 900 => TRUE
check avg(:a) < 1000 => TRUE;

/* ================================================================
 * Helper: average the last N windows of a sample-rate vector.
 *
 * The first 200-400 ms after register_sensehat_pump is hardware ramp-up:
 *   ~150 ms in lsm_init+lps_init usleep() resets,
 *   ~50  ms of I2C config writes,
 *   plus pump-thread / FIFO settling time.
 * So we measure 6 windows (1.2 s) and average only the last 4 (last 800 ms).
 * ================================================================ */

create function tail_avg(Vector of Real v, Integer skip) -> Real
  as avg(select v[i]
           from Integer i
          where i > skip and i <= dim(v));

/* ================================================================
 * ODR 5 (476 Hz) — stop, re-register, measure
 * ================================================================ */

sensehat:stop();
register_sensehat_pump(5, 1024, 0, 0);

set :a = count_accel_samples(6);
print("accel rate at ODR-5 (476 Hz) windows: " + :a);
print("  steady-state avg (skip first 2): " + tail_avg(:a, 2));
validate "accel rate at ODR 5"
check tail_avg(:a, 2) > 440 => TRUE
check tail_avg(:a, 2) < 500 => TRUE;

/* ================================================================
 * ODR 4 (238 Hz) — stop, re-register, measure
 * ================================================================ */

sensehat:stop();
register_sensehat_pump(4, 512, 0, 0);

set :a = count_accel_samples(6);
print("accel rate at ODR-4 (238 Hz) windows: " + :a);
print("  steady-state avg (skip first 2): " + tail_avg(:a, 2));
validate "accel rate at ODR 4"
check tail_avg(:a, 2) > 220 => TRUE
check tail_avg(:a, 2) < 250 => TRUE;

/* ================================================================
 * ODR 1 (14.9 Hz) + 100 ms env — signal_flows format check
 * ================================================================ */

sensehat:stop();
register_sensehat_pump(1, 2048, 100, 0);

/* No warmup needed here — first_n consumes the early items as part of
 * the 30-item window, and counts/averages tolerate them. */

/* Collect mixed readings and summarise per topic. */
set :samples = vectorof(select v
                          from Timeval v
                         where v in extract(first_n(
                           sensehat:signal_flows(["accel","temp","pressure"]), 30)));

/* Reduce each item to a single Real regardless of topic type. */
create function sample_num(Timeval tv) -> Real
  as case when sensehat:topic(tv) = "accel"
          then sensehat:accel_mag(tv)
          else sensehat:scalar(tv)
     end;

set :summary = vectorof(
  select topic, cnt, roundto(mean, 2)
    from Charstring topic, Integer cnt, Real mean
   where (topic, cnt, mean) in
         (select sensehat:topic(v), count(sensehat:topic(v)), avg(sample_num(v))
            from Timeval v
           where v in :samples
           group by sensehat:topic(v)));
print("--- signal_flows summary (ODR 1, env 100ms) ---");
print(:summary);

/* Extract per-topic [topic, count, mean] rows. */
set :s_accel = first(select r from Vector r where r in :summary and r[1] = "accel");
set :s_press = first(select r from Vector r where r in :summary and r[1] = "pressure");
set :s_temp  = first(select r from Vector r where r in :summary and r[1] = "temp");

validate "signal_flows counts"
   check :s_accel[2] > 0 => true
   check :s_press[2] > 0 => true
   check :s_temp[2] > 0 => true;

validate "signal_flows accel magnitude near 1g"
   check roundto(:s_accel[3], 0) => 1;

validate "signal_flows pressure in range"
   check :s_press[3] > 900 => true
   check :s_press[3] < 1100 => true;

validate "signal_flows temp in range"
   check :s_temp[3] > 0 => true
   check :s_temp[3] < 80 => true;

sensehat:stop();
quit;
