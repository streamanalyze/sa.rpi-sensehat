/*-*-sql-*-
 * test-sa.rpi-sensehat.osql — validation test for the sensehat datapump extension
 *
 * Tests multi-flow datapump, stop/restart, ODR cycling, re-register while
 * running, the 9-argument register (humidity, mag, joystick, accel off),
 * the I2C bus budget check and the
 * LED matrix. Works on Sense HAT v1 and v2; the v2-only colour sensor is
 * tested in test-sa.rpi-sensehat-v2.osql.
 *
 * Assumptions:
 *   - The Sense HAT is connected and /dev/i2c-1 is accessible.
 *   - The board is roughly stationary (accel magnitude ≈ 1 g).
 *
 * Run with:
 *   make test
 */

load_osql('sa.rpi-sensehat.osql');

/* ================================================================
 * Helper: count accel samples per 200 ms window
 * ================================================================ */

create function count_accel_samples(integer cnt) -> vector of real as
select vector of dim(value(tw))/win_length
from Timeval of vector tw, real win_length
where tw in twinagg(sensehat:flow("accel"), win_length, win_length)
  and win_length = .2
limit cnt;

/* ================================================================
 * Error handling — invalid ODR
 * ================================================================ */

validate "ODR 0 raises error"
   check register_sensehat_pump(0, 2048, 1000, 0)
         => ["*error*","sensehat: ODR must be 1-6",0];

validate "ODR 7 raises error"
   check register_sensehat_pump(7, 2048, 1000, 0)
         => ["*error*","sensehat: ODR must be 1-6",7];

/* ================================================================
 * ODR 6 (952 Hz) — accel + env, no gyro
 * ================================================================ */

register_sensehat_pump(6, 2048, 1000, 0);

/* ---- accel flow ---- */

validate "accel flow yields 10 readings"
   check count(extract(first_n(sensehat:flow("accel"), 10))) => 10;

validate "accel item carries topic name"
   check sensehat:topic(first(first_n(sensehat:flow("accel"), 1))) => "accel";

validate "accel payload is a 3-vector"
   check dim(sensehat:xyz(first(first_n(sensehat:flow("accel"), 1)))) => 3;

validate "accel timestamp is valid"
   check timestamp(first(first_n(sensehat:flow("accel"), 1)))
         > |2020-01-01T00:00:00Z| => true;

validate "accel magnitude near 1g when stationary"
   check roundto(avg(select am
                       from Timeval v, real am
                      where v in extract(first_n(sensehat:flow("accel"), 10))
and am = sensehat:accel_mag(v) and optional(print(am))),
                 1)
         => 1.0;

/* ---- pressure flow ---- */

validate "pressure flow yields a reading"
   check count(extract(first_n(sensehat:flow("pressure"), 1))) => 1;

validate "pressure in plausible range (hPa)"
   check select sensehat:scalar(v) > 900 and sensehat:scalar(v) < 1100
           from Timeval v
          where v in extract(first_n(sensehat:flow("pressure"), 1)) => true;

/* ---- temp flow ---- */

validate "temp flow yields a reading"
   check count(extract(first_n(sensehat:flow("temp"), 1))) => 1;

validate "temp in plausible range (C)"
   check select sensehat:scalar(v) > 0 and sensehat:scalar(v) < 80
           from Timeval v
          where v in extract(first_n(sensehat:flow("temp"), 1)) => true;

/* ---- signal_flows (merged) ---- */

validate "signal_flows merges accel and temp"
   check count(extract(first_n(sensehat:signal_flows(["accel","temp"]), 10)))
         => 10;

/* ================================================================
 * Helper: average the last N windows of a sample-rate vector.
 *
 * The first 200-400 ms after register_sensehat_pump is hardware ramp-up:
 *   ~150 ms in lsm_init+lps_init usleep() resets,
 *   ~50  ms of I2C config writes,
 *   plus pump-thread / FIFO settling time.
 * So we measure 6 windows (1.2 s) and average only the last 4 (last 800 ms).
 * ================================================================ */

create function tail_avg(Vector of Real v, Integer skip) -> Real
  as avg(select v[i]
           from Integer i
          where i > skip and i <= dim(v));

/* ---- rate at ODR 6 ----
 * Needs the Pi's VPU core clock fixed (core_freq_min=500): with the
 * ondemand governor it drops to 300 MHz after a few seconds and the I2C
 * clock with it, and the rate falls to ~500 Hz. The chip really runs at
 * ~970 Hz, and samples are stamped when read, so a window after a late
 * FIFO read can hold ~1080: hence the upper bound of 1050. */

set :a = count_accel_samples(6);
print("accel rate at ODR-6 (952 Hz) windows: " + :a);
print("  steady-state avg (skip first 2): " + tail_avg(:a, 2));
validate "accel rate at ODR 6"
check tail_avg(:a, 2) > 900 => TRUE
check tail_avg(:a, 2) < 1050 => TRUE;

/* ================================================================
 * ODR 5 (476 Hz) — stop, re-register, measure
 * ================================================================ */

sensehat:stop();
register_sensehat_pump(5, 1024, 0, 0);

set :a = count_accel_samples(6);
print("accel rate at ODR-5 (476 Hz) windows: " + :a);
print("  steady-state avg (skip first 2): " + tail_avg(:a, 2));
validate "accel rate at ODR 5"
check tail_avg(:a, 2) > 440 => TRUE
check tail_avg(:a, 2) < 500 => TRUE;

/* ================================================================
 * ODR 4 (238 Hz) — stop, re-register, measure
 * ================================================================ */

sensehat:stop();
register_sensehat_pump(4, 512, 0, 0);

set :a = count_accel_samples(6);
print("accel rate at ODR-4 (238 Hz) windows: " + :a);
print("  steady-state avg (skip first 2): " + tail_avg(:a, 2));
validate "accel rate at ODR 4"
check tail_avg(:a, 2) > 220 => TRUE
check tail_avg(:a, 2) < 250 => TRUE;

/* ================================================================
 * ODR 1 (14.9 Hz) + 100 ms env — signal_flows format check
 * ================================================================ */

sensehat:stop();
register_sensehat_pump(1, 2048, 100, 0);

/* No warmup needed here — first_n consumes the early items as part of
 * the 30-item window, and counts/averages tolerate them. */

/* Collect mixed readings and summarise per topic. */
set :samples = vectorof(select v
                          from Timeval v
                         where v in extract(first_n(
                           sensehat:signal_flows(["accel","temp","pressure"]), 30)));

/* Reduce each item to a single Real regardless of topic type. */
create function sample_num(Timeval tv) -> Real
  as case when sensehat:topic(tv) = "accel"
          then sensehat:accel_mag(tv)
          else sensehat:scalar(tv)
     end;

set :summary = vectorof(
  select topic, cnt, roundto(mean, 2)
    from Charstring topic, Integer cnt, Real mean
   where (topic, cnt, mean) in
         (select sensehat:topic(v), count(sensehat:topic(v)), avg(sample_num(v))
            from Timeval v
           where v in :samples
           group by sensehat:topic(v)));
print("--- signal_flows summary (ODR 1, env 100ms) ---");
print(:summary);

/* Extract per-topic [topic, count, mean] rows. */
set :s_accel = first(select r from Vector r where r in :summary and r[1] = "accel");
set :s_press = first(select r from Vector r where r in :summary and r[1] = "pressure");
set :s_temp  = first(select r from Vector r where r in :summary and r[1] = "temp");

validate "signal_flows counts"
   check :s_accel[2] > 0 => true
   check :s_press[2] > 0 => true
   check :s_temp[2] > 0 => true;

validate "signal_flows accel magnitude near 1g"
   check roundto(:s_accel[3], 0) => 1;

validate "signal_flows pressure in range"
   check :s_press[3] > 900 => true
   check :s_press[3] < 1100 => true;

validate "signal_flows temp in range"
   check :s_temp[3] > 0 => true
   check :s_temp[3] < 80 => true;

/* ================================================================
 * Re-registering while the pump runs must not crash (it used to
 * segfault: the new starter freed the live reader thread's context)
 * ================================================================ */

register_sensehat_pump(2, 2048, 1000, 0);
validate "accel flows before re-register"
   check count(extract(first_n(sensehat:flow("accel"), 5))) => 5;
register_sensehat_pump(2, 2048, 1000, 0);
validate "accel flows after re-register while running"
   check count(extract(first_n(sensehat:flow("accel"), 5))) => 5;

/* ================================================================
 * I2C bus budget: a request the bus cannot serve raises an error.
 * 6-byte transactions/s: accel + gyro at ODR 6 = 2 x 952, plus pressure,
 * humidity, mag and colour polled every 1 ms = 4 x 1000 -> 5904, over the
 * budget at any bus clock up to ~500 kHz. Gyro without accel is refused.
 * ================================================================ */

validate "I2C bus budget"
   check register_sensehat_pump(6, 2048, 1, 1, 1, 1, 1, 1, 0)
         => ["*error*", "sensehat: request exceeds the I2C bus budget (lower odr, turn gyro off or poll slower)", 5904]
   check register_sensehat_pump(6, 2048, 0, 1, 0, 0, 0, 0, 0)
         => ["*error*", "sensehat: gyro needs accel (the LSM9DS1 FIFO pairs them)", 1]
   check register_sensehat_pump(6, 2048, 1, 0, 1000, 1000, 50, 200, 1) => "sensehat"
   check register_sensehat_pump(5, 2048, 1, 1, 0, 0, 0, 0, 0) => "sensehat";

/* ================================================================
 * Accel and gyro off: the IMU is not read, the other sensors still are
 * ================================================================ */

set :t_off = now();
register_sensehat_pump(1, 512, 0, 0, 200, 0, 0, 0, 0);
validate "IMU off: pressure flows, accel does not"
   check count(extract(first_n(sensehat:flows_after(["pressure"], :t_off), 2))) => 2
   check count(extract(first_n(timeout(sensehat:flows_after(["accel"], :t_off), 1.5), 1))) => 0;
sensehat:stop();

/* ================================================================
 * 9-argument register — humidity, magnetometer, colour, joystick
 * ================================================================ */

register_sensehat_pump(2, 4096, 1, 1, 200, 200, 50, 200, 1);

validate "humidity in range (%rH)"
   check select sensehat:scalar(v) >= 0 and sensehat:scalar(v) <= 100
           from Timeval v
          where v in extract(first_n(sensehat:flow("humidity"), 1)) => true;

validate "humidity_temp in range (C)"
   check select sensehat:scalar(v) > 0 and sensehat:scalar(v) < 80
           from Timeval v
          where v in extract(first_n(sensehat:flow("humidity_temp"), 1)) => true;

validate "mag payload is a 3-vector"
   check dim(sensehat:xyz(first(first_n(sensehat:flow("mag"), 1)))) => 3;

/* Uncalibrated: Earth's field (25-65 uT) plus the board's hard-iron offset,
   which is several hundred uT on some HATs. */
validate "mag magnitude plausible (uT)"
   check select sqrt(m[1]*m[1] + m[2]*m[2] + m[3]*m[3]) > 5
            and sqrt(m[1]*m[1] + m[2]*m[2] + m[3]*m[3]) < 1000
           from Vector of Real m
          where m = sensehat:xyz(first(first_n(sensehat:flow("mag"), 1))) => true;

validate "mag rate (~20 Hz at mag_ms 50)"
   check count(extract(first_n(time_section(sensehat:flow("mag"), 0, 1), 100))) > 12 => true;

/* Colour (TCS34725) exists on Sense HAT v2 only; it is tested in
   test-sa.rpi-sensehat-v2.osql. On a v1 HAT only the colour flow errors. */
validate "merged new flows carry their topics"
   check (select distinct sensehat:topic(v)
            from Timeval v
           where v in extract(first_n(
                   sensehat:signal_flows(["mag","humidity"]), 40)))
         => values "mag", "humidity";

/* The joystick needs a human; only check that subscribing is possible. */
validate "joystick flow can be subscribed"
   check count(extract(first_n(timeout(sensehat:flow("joystick"), 0.2), 1))) >= 0 => true;

sensehat:stop();

/* ================================================================
 * LED matrix — values are stored as RGB565, so they read back
 * quantised to multiples of 8 (red, blue) and 4 (green).
 * ================================================================ */

validate "led_clear + readback"
   check sensehat:led_clear(10, 20, 30) => 1
   check sensehat:led_get_pixels()[1] => [8, 20, 24]
   check sensehat:led_get_pixels()[64] => [8, 20, 24];

validate "led_pixel + readback (x = column, y = row)"
   check sensehat:led_pixel(7, 0, 255, 0, 0) => 1
   check sensehat:led_get_pixels()[8] => [248, 0, 0]
   check sensehat:led_pixel(0, 7, 0, 255, 0) => 1
   check sensehat:led_get_pixels()[57] => [0, 252, 0];

validate "led_pixels + readback"
   check sensehat:led_pixels((select Vector of [4*i, 0, 255 - 4*i]
                                from Integer i where i in iota(0, 63))) => 1
   check sensehat:led_get_pixels()[1]  => [0, 0, 248]
   check sensehat:led_get_pixels()[64] => [248, 0, 0];

validate "led_low_light toggles"
   check sensehat:led_low_light(1) => 1
   check sensehat:led_low_light(0) => 0;

validate "led argument errors"
   check sensehat:led_clear(300, 0, 0) => ["*error*", "sensehat: colour must be 0-255", 300]
   check sensehat:led_clear(0, 0, 999) => ["*error*", "sensehat: colour must be 0-255", 999]
   check sensehat:led_pixel(0, 0, 1, -1, 1) => ["*error*", "sensehat: colour must be 0-255", -1]
   check sensehat:led_pixel(8, 0, 1, 1, 1) => ["*error*", "sensehat: x and y must be 0-7", 8]
   check sensehat:led_pixels([[1, 2, 3]]) => ["*error*", "sensehat: led_pixels needs 64 [r,g,b] vectors", [[1, 2, 3]]]
   check sensehat:led_pixels((select Vector of i from Integer i
                               where i in iota(1, 64) order by i))
         => ["*error*", "sensehat: each pixel must be [r,g,b] in 0-255", 1]
   check sensehat:led_clear(4294967301, 0, 0) => ["*error*", "sensehat: colour must be 0-255", 4294967301];

sensehat:led_clear(0, 0, 0);
quit;
